{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run WIMS",
            "type": "shell",
            "command": "${workspaceFolder}/SDImpCW/SRC/wims",
            "options": {
                "cwd": "${workspaceFolder}/SDImpCW"
            },
            "dependsOn": "Build WIMS",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Build WIMS",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-o",
                "${workspaceFolder}/SDImpCW/SRC/wims",
                "${workspaceFolder}/SDImpCW/SRC/Main.cpp",
                "${workspaceFolder}/SDImpCW/SRC/Product.cpp",
                "${workspaceFolder}/SDImpCW/SRC/Order.cpp",
                "${workspaceFolder}/SDImpCW/SRC/Person.cpp",
                "${workspaceFolder}/SDImpCW/SRC/Manager.cpp",
                "${workspaceFolder}/SDImpCW/SRC/Employee.cpp",
                "${workspaceFolder}/SDImpCW/SRC/InventorySystem.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}